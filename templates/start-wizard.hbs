<section class="tsc-wizard" aria-busy="{{busy}}">
  <p class="tsc-dim">{{localize "SF2eTSC.wizard.draftHint"}}</p>
  <p class="tsc-warn-box" data-wizard-error role="alert" {{#unless error}}hidden{{/unless}}>{{error}}</p>
  <fieldset class="tsc-presets">
    <legend>{{localize "SF2eTSC.wizard.presets"}}</legend>
    <div class="tsc-row-inputs">
      <label>{{localize "SF2eTSC.wizard.presets"}} <select name="presetPick">
        <option value="">{{localize "SF2eTSC.wizard.choosePreset"}}</option>
        {{#each presets}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select></label>
      <button type="button" data-action="loadPreset" {{#unless presets.length}}disabled{{/unless}}>{{localize "SF2eTSC.wizard.presetLoad"}}</button>
      <button type="button" data-action="deletePreset" {{#unless presets.length}}disabled{{/unless}} aria-label="{{localize 'SF2eTSC.wizard.presetDelete'}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
    </div>
  </fieldset>
  <fieldset>
    <legend>1. {{localize "SF2eTSC.wizard.browseActors"}}</legend>
    <div class="tsc-row-inputs tsc-wizard-filters">
      <label>{{localize "SF2eTSC.contactEditor.source"}} <select name="source">{{#each sources}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "SF2eTSC.ui.type"}} <select name="kind">{{#each kinds}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "SF2eTSC.wizard.pack"}} <select name="pack"><option value="">{{localize "SF2eTSC.wizard.allPacks"}}</option>{{#each packs}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{id}}</option>{{/each}}</select></label>
      <button type="button" data-action="refreshSources" aria-label="{{localize 'SF2eTSC.wizard.refreshSources'}}"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button>
      <label class="tsc-wizard-search">{{localize "SF2eTSC.contactEditor.filter"}} <input type="search" name="filter" value="{{filter}}" placeholder="{{localize 'SF2eTSC.ui.search'}}"></label>
    </div>
    <div class="tsc-wizard-candidates" role="group" aria-label="{{localize 'SF2eTSC.wizard.browseActors'}}">
      {{#each candidates}}
        <label class="tsc-check tsc-wizard-candidate" data-candidate-row data-name="{{name}}" data-uuid="{{uuid}}" data-kind="{{kind}}" data-pack="{{pack}}" {{#if hidden}}hidden{{/if}}>
          <input type="checkbox" data-candidate data-uuid="{{uuid}}" data-kind="{{kind}}" {{#if checked}}checked{{/if}} {{#if inRoster}}disabled{{/if}}>
          <span>{{name}} <small class="tsc-dim">{{kindLabel}} · {{sourceLabel}}{{#if inRoster}} · {{localize "SF2eTSC.wizard.inRoster"}}{{/if}}</small></span>
        </label>
      {{/each}}
      <p class="tsc-hint" data-no-candidates {{#unless noCandidates}}hidden{{/unless}}>{{localize "SF2eTSC.contactEditor.noChoices"}}</p>
    </div>
    <div class="tsc-row-inputs">
      <span aria-live="polite">{{localize "SF2eTSC.wizard.selected"}}: <strong data-selected-count>{{selectedCount}}</strong></span>
      <button type="button" data-action="addSelected" {{#unless canAdd}}disabled{{/unless}}>{{localize "SF2eTSC.wizard.addSelected"}}</button>
    </div>
  </fieldset>
  <fieldset>
    <legend>2. {{localize "SF2eTSC.ui.sensorMap"}}</legend>
    <label class="tsc-zone-in">{{localize "SF2eTSC.ui.zoneCount"}} <input type="number" name="zones" value="{{zones}}" min="{{zoneMin}}" max="{{zoneMax}}" required></label>
    <p class="tsc-dim">{{localize "SF2eTSC.wizard.zoneHint"}}</p>
  </fieldset>
  <fieldset>
    <legend>3. {{localize "SF2eTSC.wizard.roster"}}</legend>
    <div class="tsc-wizard-roster">
      {{#each roster}}
        <article class="tsc-wizard-roster-row" data-roster-row data-row-id="{{id}}">
          <header><div><h4>{{name}}</h4><small class="tsc-dim">{{sourceLabel}} · {{uuid}}</small></div><button type="button" data-action="removeRoster" aria-label="{{localize 'SF2eTSC.ui.remove'}}: {{name}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></header>
          {{#if missing}}<p class="tsc-warn-box">{{localize "SF2eTSC.wizard.missingSource"}}: {{uuid}}</p>{{/if}}
          <div class="tsc-row-inputs">
            {{#if ship}}<label>{{localize "SF2eTSC.crew.role"}} <select data-field="role">{{#each roles}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
            <label class="tsc-zone-in">{{localize "SF2eTSC.wizard.startZone"}} <input type="number" name="shipZone.{{id}}" data-field="zone" value="{{zone}}" min="1" required></label>
            {{#if ship}}<label>{{localize "SF2eTSC.ui.heading"}} <select data-field="heading">{{#each headings}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
            <label>{{localize "SF2eTSC.ui.detection"}} <select name="shipDetection.{{id}}" data-field="detection">{{#each detections}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            {{#unless player}}
              <label class="tsc-zone-in" data-tooltip="{{localize 'SF2eTSC.wizard.countHint'}}">{{localize "SF2eTSC.wizard.count"}} <input type="number" data-field="count" value="{{count}}" min="1" max="{{@root.maxCopies}}" required></label>
              <label>{{localize "SF2eTSC.wizard.copyZones"}} <input type="text" class="tsc-copy-zones" data-field="zones" value="{{zones}}" placeholder="{{localize 'SF2eTSC.wizard.copyZonesPh'}}" data-tooltip="{{localize 'SF2eTSC.wizard.copyZonesHint'}}"></label>
            {{/unless}}
          </div>
          <p class="tsc-dim">{{usage}}</p>
          {{#unless player}}<label class="tsc-check"><input type="checkbox" data-field="reuse" {{#if reuse}}checked{{/if}} {{#unless canReuse}}disabled{{/unless}}> {{localize "SF2eTSC.wizard.reuseActor"}}</label><p class="tsc-dim">{{localize "SF2eTSC.wizard.reuseHint"}}</p>{{/unless}}
          {{#if player}}
            <details class="tsc-crew-group" data-crew-group="{{id}}" open>
              <summary>{{localize "SF2eTSC.wizard.crewStations"}}</summary>
              <p class="tsc-dim">{{localize "SF2eTSC.wizard.crewHint"}} <em>{{@root.scope}}</em></p>
              <div class="tsc-wizard-crew-list">
                {{#each members}}<label class="tsc-check"><input type="checkbox" data-member data-uuid="{{uuid}}" {{#if checked}}checked{{/if}} {{#if locked}}disabled{{/if}}> {{> tscOccupant occupant size="sm"}}<small class="tsc-dim">{{#if missing}}{{localize "SF2eTSC.crew.missingActor"}}{{else}}{{#if observer}}{{localize "SF2eTSC.roles.observer"}}{{else}}{{#if station}}{{station}}{{else}}{{localize "SF2eTSC.wizard.freeCrew"}}{{/if}}{{/if}}{{/if}}{{#if inCombat}} · {{localize "SF2eTSC.wizard.alreadyInCombat"}}{{/if}}</small></label>{{else}}<p class="tsc-hint">{{localize "SF2eTSC.crew.empty"}}</p>{{/each}}
              </div>
              <p class="tsc-dim">{{localize "SF2eTSC.wizard.stationHint"}}</p>
              {{#each stations}}<div class="tsc-wizard-station"><label>{{name}} <select data-station="{{id}}"><option value="" {{#if empty}}selected{{/if}}>{{localize "SF2eTSC.crew.unoccupied"}}</option>{{#if unavailable}}<option value="{{unavailable}}" selected>{{localize "SF2eTSC.crew.missingActor"}}: {{unavailable}}</option>{{/if}}{{#each choices}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><small class="tsc-dim">{{localize "SF2eTSC.wizard.sourceOccupant"}}: {{> tscOccupant current size="sm"}}</small></div>{{/each}}
              {{#each orphanAssignments}}<p class="tsc-warn">{{localize "SF2eTSC.wizard.staleAssignment"}}: {{stationId}} <button type="button" data-action="removeAssignment" data-station-id="{{stationId}}">{{localize "SF2eTSC.ui.remove"}}</button></p>{{/each}}
            </details>
          {{/if}}
        </article>
      {{else}}<p class="tsc-hint">{{localize "SF2eTSC.wizard.emptyRoster"}}</p>{{/each}}
    </div>
    {{#if characters.length}}<details><summary>{{localize "SF2eTSC.wizard.otherCharacters"}}</summary><div class="tsc-wizard-crew-list">{{#each characters}}<label class="tsc-check"><input type="checkbox" data-extra-crew data-uuid="{{uuid}}" {{#if checked}}checked{{/if}}> {{name}}{{#if missing}} <small class="tsc-warn">{{localize "SF2eTSC.crew.missingActor"}}</small>{{/if}}</label>{{/each}}</div></details>{{/if}}
  </fieldset>
  <fieldset>
    <legend>4. {{localize "SF2eTSC.wizard.objects"}}</legend>
    <div class="tsc-obj-rows" data-obj-rows>
      {{#each objects}}<div class="tsc-row-inputs tsc-obj-row" data-object-id="{{id}}">
        <label>{{localize "SF2eTSC.ui.name"}} <input type="text" data-f="name" value="{{name}}" required></label>
        <label>{{localize "SF2eTSC.ui.type"}} <select data-f="type">{{#each types}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="tsc-zone-in">{{localize "SF2eTSC.ui.zone"}} <input type="number" data-f="zone" min="1" value="{{zone}}" required></label>
        <label>{{localize "SF2eTSC.ui.detection"}} <select data-f="detection">{{#each detections}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="tsc-wizard-art">{{localize "SF2eTSC.mapAppearance.objectArt"}} <input type="text" data-f="art" value="{{art}}"></label>
        <button type="button" data-action="pickObjectArt" aria-label="{{localize 'SF2eTSC.mapAppearance.browse'}}"><i class="fa-solid fa-image" aria-hidden="true"></i></button>
        <button type="button" data-action="removeObjRow" aria-label="{{localize 'SF2eTSC.wizard.removeObject'}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      </div>{{/each}}
    </div>
    <template data-obj-template><div class="tsc-row-inputs tsc-obj-row">
      <label>{{localize "SF2eTSC.ui.name"}} <input type="text" data-f="name" required></label>
      <label>{{localize "SF2eTSC.ui.type"}} <select data-f="type">{{#each objectTypes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="tsc-zone-in">{{localize "SF2eTSC.ui.zone"}} <input type="number" data-f="zone" min="1" value="{{midZone}}" required></label>
      <label>{{localize "SF2eTSC.ui.detection"}} <select data-f="detection">{{#each detectionLevels}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="tsc-wizard-art">{{localize "SF2eTSC.mapAppearance.objectArt"}} <input type="text" data-f="art"></label>
      <button type="button" data-action="pickObjectArt" aria-label="{{localize 'SF2eTSC.mapAppearance.browse'}}"><i class="fa-solid fa-image" aria-hidden="true"></i></button>
      <button type="button" data-action="removeObjRow" aria-label="{{localize 'SF2eTSC.wizard.removeObject'}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div></template>
    <button type="button" data-action="addObjRow"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "SF2eTSC.ui.addObject"}}</button>
  </fieldset>
  {{#if review}}<fieldset class="tsc-wizard-review" data-wizard-review role="status">
    <legend>{{localize "SF2eTSC.wizard.review"}}</legend>
    <p>{{localize "SF2eTSC.wizard.reviewHint"}}</p>
    <dl>
      <dt>{{localize "SF2eTSC.roleTypes.player"}}</dt><dd>{{review.player}}</dd>
      <dt>{{localize "SF2eTSC.roleTypes.npc"}}</dt><dd>{{review.npc}}</dd>
      <dt>{{localize "SF2eTSC.ui.hazards"}}</dt><dd>{{review.hazards}}</dd>
      <dt>{{localize "SF2eTSC.wizard.objects"}}</dt><dd>{{review.objects}}</dd>
      <dt>{{localize "SF2eTSC.wizard.total"}}</dt><dd>{{review.total}}</dd>
      <dt>{{localize "SF2eTSC.wizard.newActors"}}</dt><dd>{{review.copies}}</dd>
      <dt>{{localize "SF2eTSC.wizard.reusedActors"}}</dt><dd>{{review.reused}}</dd>
      <dt>{{localize "SF2eTSC.wizard.selectedCrew"}}</dt><dd>{{review.crew}}</dd>
      <dt>{{localize "SF2eTSC.wizard.unidentified"}}</dt><dd>{{review.unidentified}}</dd>
    </dl>
    <ul class="tsc-list">{{#each review.entries}}<li><strong>{{name}} × {{count}}</strong> · {{localize "SF2eTSC.ui.zone"}}: {{zones}} · {{detection}} {{heading}}<small class="tsc-dim"> · {{usage}}</small>{{#if assignments.length}}<ul>{{#each assignments}}<li>{{station}}: {{name}}</li>{{/each}}</ul>{{/if}}</li>{{/each}}{{#each review.custom}}<li>{{name}} · {{localize "SF2eTSC.ui.zone"}}: {{zone}} · {{detectionLabel}}</li>{{/each}}</ul>
    <button type="button" data-action="editDraft">{{localize "SF2eTSC.wizard.backToEdit"}}</button>
  </fieldset>{{/if}}
  <footer>
    <input type="text" name="presetName" value="{{presetName}}" placeholder="{{localize 'SF2eTSC.wizard.presetName'}}" aria-label="{{localize 'SF2eTSC.wizard.presetName'}}">
    <button type="button" data-action="savePreset"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> {{localize "SF2eTSC.wizard.presetSave"}}</button>
    <button type="button" data-action="cancel">{{localize "SF2eTSC.ui.cancel"}}</button>
    <button type="submit" data-wizard-submit>{{submitLabel}}</button>
  </footer>
</section>
