{{!-- One ship card of the crew panel (Crew Manager window and starship sheet "Crew" tab). --}}
<article class="tsc-station">
  <header><h4>{{name}}</h4>{{#if small}}<span class="tsc-pill warn">⚠ {{localize "SF2eTSC.ui.smallCrew"}}</span>{{/if}}</header>
  <ul class="tsc-post-strip" aria-label="{{localize 'SF2eTSC.tabs.stations'}}">{{#each posts}}<li class="{{#if malf}}malf{{/if}}">{{> tscOccupant occupant size="md" hideName=true}}<span class="tsc-post-name">{{name}}</span><span class="tsc-dim tsc-post-occ {{#if free}}tsc-free{{/if}}">{{occupant.name}}</span>{{#if free}}{{#if ../myCrewUuid}}<button type="button" class="tsc-post-claim" data-action="claim" data-ship-uuid="{{../uuid}}" data-station-id="{{id}}" data-crew-uuid="{{../myCrewUuid}}" data-tooltip="{{localize 'SF2eTSC.crew.claim'}}" aria-label="{{localize 'SF2eTSC.crew.claim'}}"><i class="fa-solid fa-right-to-bracket"></i></button>{{/if}}{{/if}}</li>{{/each}}</ul>
  <table class="tsc-table">
    <thead><tr><th>{{localize "SF2eTSC.crew.character"}}</th><th>{{localize "SF2eTSC.crew.player"}}</th><th>{{localize "SF2eTSC.crew.role"}}</th><th>{{localize "SF2eTSC.crew.station"}}</th><th>{{localize "SF2eTSC.crew.ready"}}</th><th></th></tr></thead>
    <tbody>{{#each rows}}<tr>
      <td>{{> tscOccupant occupant size="sm"}}{{#if combatantMissing}} <span class="tsc-pill warn" data-tooltip="{{localize 'SF2eTSC.errors.noCombatantHud'}}">⚠</span>{{/if}}</td><td>{{player}}</td><td>{{#if @root.catalog.roles}}{{#if ../canAssign}}<select data-role-select data-crew-uuid="{{actorUuid}}" aria-label="{{localize 'SF2eTSC.crew.role'}}">{{#each @root.catalog.roles}}<option value="{{id}}" {{#if (eq id ../roleId)}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{else}}{{role}}{{/if}}{{else}}{{role}}{{/if}}</td><td>{{#if canChange}}<select data-station-select data-ship-uuid="{{../uuid}}" data-crew-uuid="{{actorUuid}}" data-current="{{stationId}}" data-can-assign="{{../canAssign}}" aria-label="{{localize 'SF2eTSC.crew.changeStation'}}"><option value="">— {{localize "SF2eTSC.crew.noStation"}} —</option>{{#each stations}}<option value="{{id}}" data-occupied="{{occupied}}" {{#if mine}}selected{{/if}} {{#if occupied}}{{#unless ../../canAssign}}disabled{{/unless}}{{/if}}>{{#if occupied}}● {{else}}○ {{/if}}{{name}} — {{#if mine}}{{localize "SF2eTSC.crew.yourStation"}}{{else}}{{#if occupied}}{{localize "SF2eTSC.crew.occupiedBy" name=occupantName}}{{else}}{{localize "SF2eTSC.crew.unoccupied"}}{{/if}}{{/if}}{{#if malf}} ⚠{{/if}}</option>{{/each}}</select>{{else}}{{station}}{{/if}}</td>
      <td><button type="button" data-action="ready" data-ship-uuid="{{../uuid}}" data-crew-uuid="{{actorUuid}}" data-ready="{{ready}}" aria-pressed="{{ready}}" {{#unless mine}}{{#unless @root.isGM}}disabled{{/unless}}{{/unless}}>{{#if ready}}✔{{else}}○{{/if}}</button></td>
      <td>{{#if stationId}}<button type="button" data-action="unhelm" data-ship-uuid="{{../uuid}}" data-station-id="{{stationId}}" data-crew-uuid="{{actorUuid}}" aria-label="{{localize 'SF2eTSC.crew.release'}}"><i class="fa-solid fa-right-from-bracket"></i></button>{{/if}}
      {{#if ../canAssign}}<button type="button" class="danger" data-action="remove" data-ship-uuid="{{../uuid}}" data-crew-uuid="{{actorUuid}}"><i class="fa-solid fa-user-minus"></i></button>{{/if}}</td>
    </tr>
    {{#if canChange}}{{#if ../free.length}}<tr class="tsc-sub"><td colspan="9"><span class="tsc-dim">{{localize "SF2eTSC.crew.claimFree"}}:</span> {{#each ../free}}<button type="button" data-action="claim" data-ship-uuid="{{../../uuid}}" data-station-id="{{id}}" data-crew-uuid="{{../actorUuid}}">{{name}}{{#if malf}} ⚠{{/if}}</button> {{/each}}</td></tr>{{/if}}{{/if}}
    {{else}}<tr><td colspan="6" class="tsc-hint">{{localize "SF2eTSC.crew.empty"}}</td></tr>{{/each}}</tbody>
  </table>
  {{#if @root.isGM}}<p class="tsc-dim">{{localize "SF2eTSC.crew.gmForceHint"}}</p>{{/if}}
</article>
