<section class="tsc-appearance-fields">
{{#if objectMode}}
  <h3>{{objectName}}</h3>
  <p>{{localize 'SF2eTSC.mapAppearance.objectHint'}}</p>
  <label>{{localize 'SF2eTSC.mapAppearance.image'}}<span class="tsc-image-field"><input type="text" name="art" value="{{art}}"><button type="button" data-action="browseImage" data-field="art" aria-label="{{localize 'SF2eTSC.mapAppearance.browse'}}"><i class="fa-solid fa-folder-open"></i></button></span></label>
  <fieldset><legend>{{localize 'SF2eTSC.mapVisual.orientation'}}</legend>
    <label>{{localize 'SF2eTSC.mapVisual.rotation'}} <input type="number" name="rotation" step="1" value="{{transform.rotation}}"></label>
    <label>{{localize 'SF2eTSC.mapVisual.flipX'}} <input type="checkbox" name="flipX" {{#if transform.flipX}}checked{{/if}}></label>
    <label>{{localize 'SF2eTSC.mapVisual.flipY'}} <input type="checkbox" name="flipY" {{#if transform.flipY}}checked{{/if}}></label>
    <label>{{localize 'SF2eTSC.mapVisual.baseDirection'}} <select name="baseDirection">{{#each directions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <p>{{localize 'SF2eTSC.mapVisual.baseHint'}}</p>
    <div class="tsc-transform-buttons">
      <button type="button" data-action="transformControl" data-op="left">{{localize 'SF2eTSC.mapVisual.rotateLeft'}}</button>
      <button type="button" data-action="transformControl" data-op="right">{{localize 'SF2eTSC.mapVisual.rotateRight'}}</button>
      <button type="button" data-action="transformControl" data-op="flipX">{{localize 'SF2eTSC.mapVisual.flipX'}}</button>
      <button type="button" data-action="transformControl" data-op="flipY">{{localize 'SF2eTSC.mapVisual.flipY'}}</button>
      <button type="button" data-action="transformControl" data-op="resetRotation">{{localize 'SF2eTSC.mapVisual.resetRotation'}}</button>
      <button type="button" data-action="transformControl" data-op="resetFlipping">{{localize 'SF2eTSC.mapVisual.resetFlipping'}}</button>
      <button type="button" data-action="transformControl" data-op="resetAll">{{localize 'SF2eTSC.mapVisual.resetAll'}}</button>
    </div>
  </fieldset>
{{else}}
  <label>{{localize 'SF2eTSC.mapAppearance.mode'}}<select name="mode">{{#each modes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
  <label>{{localize 'SF2eTSC.mapAppearance.artSize'}}<input type="number" name="artSize" min="32" max="128" step="1" value="{{a.artSize}}"></label>
  <fieldset><legend>{{localize 'SF2eTSC.mapVisual.courseArrow'}}</legend>
    <label>{{localize 'SF2eTSC.mapVisual.display'}}<select name="arrowMode">{{#each arrowModes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize 'SF2eTSC.mapVisual.customImage'}}<span class="tsc-image-field"><input type="text" name="arrowImage" value="{{a.arrowImage}}" readonly><button type="button" data-action="browseImage" data-field="arrowImage" aria-label="{{localize 'SF2eTSC.mapVisual.selectImage'}}"><i class="fa-solid fa-folder-open"></i></button><button type="button" data-action="clearImage" data-field="arrowImage" aria-label="{{localize 'SF2eTSC.mapVisual.clearImage'}}"><i class="fa-solid fa-xmark"></i></button></span></label>
    <img class="tsc-arrow-preview" data-image-preview="arrowImage" src="{{a.arrowImage}}" alt="{{localize 'SF2eTSC.mapVisual.preview'}}" {{#unless a.arrowImage}}hidden{{/unless}}>
    <label>{{localize 'SF2eTSC.mapVisual.size'}}<input type="number" name="arrowSize" min="10" max="64" value="{{a.arrowSize}}"></label>
    <label>{{localize 'SF2eTSC.mapVisual.gap'}}<input type="number" name="arrowGap" min="0" max="24" value="{{a.arrowGap}}"></label>
    <label>{{localize 'SF2eTSC.mapVisual.position'}}<select name="arrowPosition">{{#each positions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize 'SF2eTSC.mapAppearance.opacity'}}<input type="number" name="arrowOpacity" min="0" max="1" step="0.05" value="{{a.arrowOpacity}}"></label>
    <label>{{localize 'SF2eTSC.mapVisual.autoMirror'}}<input type="checkbox" name="autoMirror" {{#if a.autoMirror}}checked{{/if}}></label>
    <p>{{localize 'SF2eTSC.mapVisual.autoHint'}}</p>
  </fieldset>
  <fieldset><legend>{{localize 'SF2eTSC.mapAppearance.colors'}}</legend>
    <label>{{localize 'SF2eTSC.mapAppearance.customColors'}}<input type="checkbox" name="customColors" {{#if customColors}}checked{{/if}}></label>
    <label>{{localize 'SF2eTSC.mapAppearance.textColor'}}<input type="color" name="textColor" value="{{textColor}}"></label>
    <label>{{localize 'SF2eTSC.mapAppearance.mutedColor'}}<input type="color" name="mutedColor" value="{{mutedColor}}"></label>
    <label>{{localize 'SF2eTSC.mapAppearance.accentColor'}}<input type="color" name="accentColor" value="{{accentColor}}"></label>
  </fieldset>
  <fieldset><legend>{{localize 'SF2eTSC.mapAppearance.background'}}</legend>
    <label>{{localize 'SF2eTSC.mapAppearance.image'}}<span class="tsc-image-field"><input type="text" name="background" value="{{a.background}}"><button type="button" data-action="browseImage" data-field="background" aria-label="{{localize 'SF2eTSC.mapAppearance.browse'}}"><i class="fa-solid fa-folder-open"></i></button></span></label>
    <label>{{localize 'SF2eTSC.mapAppearance.opacity'}}<input type="number" name="opacity" min="0" max="1" step="0.05" value="{{a.opacity}}"></label>
    <label>{{localize 'SF2eTSC.mapAppearance.fade'}}<input type="number" name="fade" min="0" max="1" step="0.05" value="{{a.fade}}"></label>
    <label>{{localize 'SF2eTSC.mapAppearance.blur'}}<input type="number" name="blur" min="0" max="20" step="1" value="{{a.blur}}"></label>
    <label>{{localize 'SF2eTSC.mapVisual.rotation'}}<input type="number" name="backgroundRotation" step="1" value="{{a.backgroundRotation}}"></label>
    <label>{{localize 'SF2eTSC.mapVisual.flipX'}}<input type="checkbox" name="backgroundFlipX" {{#if a.backgroundFlipX}}checked{{/if}}></label>
    <label>{{localize 'SF2eTSC.mapVisual.flipY'}}<input type="checkbox" name="backgroundFlipY" {{#if a.backgroundFlipY}}checked{{/if}}></label>
    <p>{{localize 'SF2eTSC.mapAppearance.backgroundHint'}}</p><p>{{localize 'SF2eTSC.mapVisual.backgroundHint'}}</p>
  </fieldset>
{{/if}}
  <footer class="tsc-detail-actions"><button type="submit"><i class="fa-solid fa-check"></i> {{localize 'SF2eTSC.ui.save'}}</button><button type="button" data-action="resetAppearance">{{localize 'SF2eTSC.mapAppearance.reset'}}</button></footer>
</section>
