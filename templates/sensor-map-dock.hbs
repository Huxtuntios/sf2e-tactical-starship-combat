<section class="tsc-dock" aria-label="{{localize 'SF2eTSC.ui.stationHud'}}" {{#if noCombat}}hidden{{/if}}>
{{#unless noCombat}}
  {{#if dock.none}}
    {{#unless isGM}}<p class="tsc-dim tsc-dock-empty"><i class="fa-solid fa-gamepad" aria-hidden="true"></i> {{localize "SF2eTSC.ui.noStationHelmed"}}</p>{{/unless}}
  {{else}}
    <header class="tsc-dock-head">
      <span class="tsc-dock-title"><i class="{{dock.stationIcon}}" aria-hidden="true"></i> <strong>{{dock.station}}</strong> <small class="tsc-dim">{{dock.crew}} · {{dock.ship}}</small></span>
      {{#if dock.selectors.[1]}}<span class="tsc-dock-pick" role="tablist">{{#each dock.selectors}}<button type="button" role="tab" class="tsc-chip {{#if active}}active{{/if}}" data-action="dockPick" data-index="{{i}}" title="{{label}}">{{short}}</button>{{/each}}</span>{{/if}}
      {{#if dock.boosted}}<span class="tsc-pill" title="{{dock.boostCaption}}">{{localize "SF2eTSC.boost.active"}}</span>{{/if}}
      {{#if dock.malfunctioning}}<span class="tsc-pill bad" role="alert">⚠ {{localize "SF2eTSC.ui.malfunctioning"}}</span>{{/if}}
      {{#if dock.noCombatant}}<span class="tsc-pill warn" role="alert">⚠ {{localize "SF2eTSC.errors.noCombatantHud"}}</span>{{/if}}
    </header>
    <details><summary>{{localize "SF2eTSC.rolls.stationDCs"}}</summary>{{#if dock.dcRows.length}}<div class="tsc-station-dcs">{{#each dock.dcRows}}<span>{{label}}: {{value}}</span>{{/each}}</div>{{/if}}</details>
<ul class="tsc-dock-actions">
      
{{#each dock.actions}}
      <li class="tsc-action-row">
        <button type="button" data-action="dockAct" data-action-id="{{id}}" {{#unless enabled}}disabled{{/unless}} class="tsc-action-cost {{#if warnings}}has-warning{{/if}}" title="{{#if enabled}}{{localize 'SF2eTSC.ui.execute'}}: {{name}} — {{costLabel}}{{else}}{{reasons}}{{/if}}" aria-label="{{localize 'SF2eTSC.ui.execute'}}: {{name}} — {{costLabel}}"><span class="cost" aria-hidden="true">{{icon}}</span></button>
        <button type="button" class="tsc-action-name" data-action="describeAction" data-action-id="{{id}}" aria-haspopup="dialog" aria-label="{{localize 'SF2eTSC.ui.actionDescription'}}: {{name}}">{{name}}</button>
        <span class="tsc-action-meta">{{#if needsTarget}}<i class="fa-solid fa-bullseye" title="{{localize 'SF2eTSC.ui.target'}}" aria-hidden="true"></i>{{/if}}{{#if frequency}}<small>{{frequency}}</small>{{/if}}</span>
        {{#if reasons}}<button type="button" class="tsc-action-warning {{#unless enabled}}blocked{{/unless}}" data-action="actionWarning" data-tooltip-text="{{reasons}}{{#if warnings}} · {{warnings}}{{/if}}" aria-label="{{reasons}}{{#if warnings}} · {{warnings}}{{/if}}"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i></button>{{else}}{{#if warnings}}<button type="button" class="tsc-action-warning" data-action="actionWarning" data-tooltip-text="{{warnings}}" aria-label="{{warnings}}"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i></button>{{/if}}{{/if}}
        <template class="tsc-description-content"><p>{{costLabel}}{{#if frequency}} · {{frequency}}{{/if}}</p>{{{desc}}}{{#if reasons}}<p>{{reasons}}</p>{{/if}}{{#if warnings}}<p>{{warnings}}</p>{{/if}}</template>
      </li>
      {{/each}}
    </ul>
  {{/if}}
{{/unless}}
</section>
