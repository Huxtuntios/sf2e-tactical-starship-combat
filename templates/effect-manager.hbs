<section class="tsc-effect-manager-body">
  {{#if isGM}}<div class="tsc-btn-row"><button type="button" data-action="add"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "SF2eTSC.effects.add"}}</button><button type="button" data-action="process" {{#unless canProcess}}disabled{{/unless}}>{{localize "SF2eTSC.effects.process"}}</button></div>{{else}}<p class="hint">{{localize "SF2eTSC.effects.readOnly"}}</p>{{/if}}
  {{#if isGM}}<div class="tsc-effect-manager-state" role="group" aria-label="{{localize 'SF2eTSC.effects.title'}}">
    <button type="button" data-action="setOperational" data-state="operational" title="{{localize 'SF2eTSC.effects.operationalHint'}}"><i class="fa-solid fa-wrench" aria-hidden="true"></i> {{localize "SF2eTSC.status.operational"}}</button>
    <button type="button" class="danger" data-action="setOperational" data-state="destroyed" title="{{localize 'SF2eTSC.effects.destroyedHint'}}"><i class="fa-solid fa-skull" aria-hidden="true"></i> {{localize "SF2eTSC.status.destroyed"}}</button>
  </div>
  <form class="tsc-effect-condition-form" data-condition-form>
    <label>{{localize "SF2eTSC.effects.conditionLabel"}}
      <select name="conditionSlug" required>
        {{#each conditionOptions}}<option value="{{slug}}">{{label}}</option>{{/each}}
      </select>
    </label>
    <label>{{localize "SF2eTSC.effects.conditionValue"}}
      <input name="conditionValue" type="number" min="1" max="100" step="1" value="1" required>
    </label>
    <button type="button" data-action="addCondition" {{#unless conditionOptions.length}}disabled{{/unless}}><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "SF2eTSC.effects.addCondition"}}</button>
    <p class="hint">{{localize "SF2eTSC.effects.conditionValueHint"}}</p>
  </form>{{/if}}
  <p class="hint">{{localize "SF2eTSC.effects.processHint"}}</p>
  <p role="alert">{{error}}</p>
  {{#each receipts}}
  <div class="tsc-effect-packet"><span>{{statusLabel}} · {{label}} · {{amount}}</span><button type="button" data-action="apply" data-receipt-id="{{id}}" {{#unless canApply}}disabled{{/unless}}>{{localize "SF2eTSC.persistent.apply"}}</button></div>
  {{/each}}
  <h4>{{localize "SF2eTSC.effects.nativeConditions"}}</h4>
  <div class="tsc-effect-manager-list">
    {{#each conditions}}
    <article class="tsc-effect-manager-row" data-condition-id="{{id}}">
      <header><strong>{{label}}{{#if valued}} · {{value}}{{/if}}</strong>{{#unless active}}<span class="hint">{{localize "SF2eTSC.effects.inactive"}}</span>{{/unless}}</header>
      {{#if @root.isGM}}<button type="button" data-action="removeCondition" data-item-id="{{id}}">{{localize "SF2eTSC.effects.remove"}}</button>{{/if}}
    </article>
    {{else}}<p class="hint">{{localize "SF2eTSC.effects.empty"}}</p>{{/each}}
  </div>
  <h4>{{localize "SF2eTSC.effects.moduleEffects"}}</h4>
  <div class="tsc-effect-manager-list tsc-effect-applications">
    {{#each effects}}
    <article class="tsc-effect-application" data-effect-id="{{id}}">
      <header><strong>{{label}}{{#if details}} · {{details}}{{/if}}</strong><span>{{statusLabel}}</span></header>
      <p>{{summary}}</p>
      {{#if caption}}<p class="hint">{{caption}}</p>{{/if}}
      {{#if ignoreImmunities}}<p class="hint">{{localize "SF2eTSC.effects.ignoreImmunities"}}</p>{{/if}}
      {{#if foreignSource}}<p class="hint">{{localize "SF2eTSC.effects.copiedSourceHint"}}</p>{{/if}}
      {{#if persistent}}<p>{{persistent}}</p>{{/if}}
      {{#if shipRecipient}}<p>{{localize "SF2eTSC.effects.targets.entire"}} — {{#if shipRecovered}}{{localize "SF2eTSC.effects.status.recovered"}}{{else}}{{statusLabel}}{{/if}}</p>{{/if}}
      {{#each recipients}}<div class="tsc-effect-recipient"><span>{{label}} · {{statusLabel}} <small>{{itemId}}</small></span>{{#if canRecover}}<button type="button" data-action="recover" data-effect-id="{{effectId}}" data-actor-uuid="{{actorUuid}}">{{localize "SF2eTSC.persistent.recover"}}</button>{{/if}}</div>{{/each}}
      {{#each rejected}}<p class="tsc-effect-error">{{label}} — {{error}}</p>{{/each}}
      {{#if @root.isGM}}<div class="tsc-btn-row">
        {{#if canRecoverShip}}<button type="button" data-action="recover" data-effect-id="{{id}}">{{localize "SF2eTSC.persistent.recover"}} — {{localize "SF2eTSC.effects.targets.ship"}}</button>{{/if}}
        <button type="button" data-action="timing" data-effect-id="{{id}}">{{localize "SF2eTSC.qol.effectTiming"}}</button>
        <button type="button" data-action="remove" data-effect-id="{{id}}">{{localize "SF2eTSC.ui.remove"}}</button>
      </div>{{/if}}
    </article>
    {{else}}<p class="hint">{{localize "SF2eTSC.effects.empty"}}</p>{{/each}}
  </div>
</section>
